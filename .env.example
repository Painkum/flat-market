# Robinhood Chain — official public RPC is rate-limited.
# Docs: https://docs.robinhood.com/chain/connecting
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Set these after `forge script script/Deploy.s.sol` on testnet.
NEXT_PUBLIC_COLLECTION_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_REDEMPTION_ADDRESS=

# Optional WalletConnect Cloud project id (not required for injected wallets).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Required to pin creator uploads to IPFS via Pinata.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Foundry deploy (never commit the real key)
PRIVATE_KEY=
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
TREASURY=
FEE_BPS=250
